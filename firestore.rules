rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only access to the portfolio document; no client writes anywhere.
    match /portfolio/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
